# ==============================================================================
# CẤU HÌNH CHUNG HỆ THỐNG (APPLICATION SETTINGS)
# ==============================================================================
APP_NAME="Intelligent Document Chatbot"
APP_ENV="development"
API_HOST="0.0.0.0"
API_PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# ==============================================================================
# CƠ SỞ DỮ LIỆU & LƯU TRỮ (DATABASE & STORAGE)
# ==============================================================================
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/doc_chatbot"
CHROMA_PERSIST_DIR="./storage/chroma_db"
UPLOAD_DIR="./storage/uploads"
MAX_FILE_SIZE_MB=20

# ==============================================================================
# CẤU HÌNH MÔ HÌNH AI & RAG (LLM & EMBEDDING)
# ==============================================================================
LLM_PROVIDER="gemini"                      # Hỗ trợ: gemini | openai | ollama
LLM_API_KEY="AIzaSyBSJ9gDNyFqaNKP-TB7yqd9V_aPoOypJgA"
LLM_MODEL="gemini-3.8-flash"
LLM_TEMPERATURE=0.1

EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_MODEL_NAME="BAAI/bge-m3"

# ==============================================================================
# THAM SỐ LUỒNG RAG (RAG PIPELINE PARAMETERS)
# ==============================================================================
CHUNK_SIZE=400
CHUNK_OVERLAP=60
TOP_K=5
RETRIEVAL_TOP_K=5

